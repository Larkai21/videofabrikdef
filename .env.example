# Copia este archivo a .env y rellena las claves que tengas.
# Sin claves externas el pipeline funciona en modo mock (útil para desarrollo).

# Infraestructura local (docker compose)
DATABASE_URL=postgres://fabrica:fabrica@localhost:55432/fabrica
REDIS_URL=redis://localhost:56379

# API
API_PORT=3001
API_HOST=127.0.0.1

# Dashboard (Vite)
VITE_API_URL=http://localhost:3001

# LLM para guion, scoring, juez de alineación y captions VLM
# LLM_PROVIDER: openai | openrouter | mock
# Con openrouter el modelo lleva prefijo de vendor (p. ej. openai/gpt-5-mini)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gpt-5-mini

# Embeddings locales: fastembed | hash (hash = mock determinista sin modelo)
EMBEDDINGS_PROVIDER=hash

# TTS: edge | mock  (ElevenLabs entra como flag por canal en S2)
TTS_PROVIDER=edge

# Stock de vídeo/imagen
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Generación de imagen (último recurso de la cascada)

# Publicación en YouTube (S3): cliente OAuth de Google Cloud Console con la
# YouTube Data API v3 habilitada (tipo "aplicación web", redirect
# http://localhost:3001/youtube/callback). El refresh token se guarda por
# canal al conectar desde Ajustes. Sin credenciales: PUBLISH_PROVIDER=mock
# simula la subida (para desarrollo) y el botón real queda deshabilitado.
# Proyectos sin auditar: los vídeos quedan bloqueados en privado (esperado).
PUBLISH_PROVIDER=mock
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# Rutas de datos (relativas a la raíz del repo si no son absolutas)
LIBRARY_DIR=library
OUTPUTS_DIR=outputs
